{
  "openapi": "3.1.0",
  "info": {
    "title": "Market Data API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://market-data.sandbox.rails.xyz"
    }
  ],
  "paths": {
    "/api/v1/market-data": {
      "get": {
        "summary": "Retrieve market data for a given list of markets",
        "operationId": "getMarketData",
        "parameters": [
          {
            "name": "markets",
            "in": "query",
