          {
            "name": "market",
            "in": "path",
            "required": true,
            "description": "Underlying market, e.g. `BTC-USDT`.",
            "schema": { "type": "string" }
          },
          {
            "name": "expiry",
            "in": "path",
            "required": true,
            "description": "Expiration date, `YYYY-MM-DD`.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
