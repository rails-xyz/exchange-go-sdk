              "$ref": "#/components/schemas/CancelOrderQueued"
            }
          },
          "unqueued": {
            "type": "array",
            "description": "Open orders the sweep did not queue a cancel for. Present only when the queue refused part-way.",
            "items": {
              "$ref": "#/components/schemas/UnqueuedCancel"
            }
          }
        },
        "required": [
          "action",
          "clientRequestId",
          "count",
          "cancels"
        ]
