          "accepted": {
            "type": "boolean",
            "description": "Always `false`."
          },
          "body": {
            "type": "string",
            "description": "Always `order queued, pending acceptance`."
          },
          "action": {
            "type": "string",
            "description": "Always `modify`."
          },
          "messageId": {
            "type": "string",
            "description": "Identifier assigned to the queued request."
