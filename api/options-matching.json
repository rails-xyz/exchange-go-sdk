          "clientRequestId": {
            "type": "string",
            "description": "Client-generated UUID for correlation."
          },
          "contract": {
            "type": "string",
            "description": "Contract name."
          },
          "orderId": {
            "type": "string",
            "description": "Unique identifier for the order."
          }
        },
        "required": [
          "queued",
          "accepted",
          "action",
          "contract",
          "orderId"
        ]
