            "description": "Contract name."
          }
        },
        "required": [
          "orderId",
          "contract"
        ]
      },
      "OrderStatus": {
        "type": "object",
        "properties": {
          "clientRequestId": {
            "type": "string",
            "description": "Client-generated UUID for correlation."
          },
          "status": {
            "type": "string",
