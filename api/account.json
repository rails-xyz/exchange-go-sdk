{
  "openapi": "3.1.0",
  "info": {
    "title": "User Account API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://user-account.sandbox.rails.xyz"
    }
  ],
  "paths": {
    "/api/v1/balances": {
      "get": {
        "summary": "Retrieve account balances",
        "operationId": "getAccountBalances",
        "parameters": [
          {
            "$ref": "#/components/parameters/market"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
